  "sourceExcerpts": {
    "round": "function n(e){return Math.round(10*e)/10}",
    "calculate": "f=i.map(e=>h.get(e)).filter(e=>!!e),g=f.length===e.MAX_SLOTS?f[f.length-1]:null,j=n(f.reduce((e,t)=>e+t.score,0)),N=g?g.score:0,v=Math.min(n(j+N),e.MAX_SCORE),y=[...d=e.TIERS].sort((e,t)=>t.minScore-e.minScore).find(e=>v>=e.minScore)??d[d.length-1],w=[...e.TIERS].sort((e,t)=>e.minScore-t.minScore).find(e=>e.minScore>v)??null",
    "autoBest": "let[t,...s]=[...e.ALL_RUNES].sort((e,t)=>t.score-e.score).slice(0,e.MAX_SLOTS);c([...s.map(e=>e.id),t.id])",
    "toggle": "c(s=>s.includes(t.id)?s.filter(e=>e!==t.id):s.length>=e.MAX_SLOTS?s:[...s,t.id])",
    "moveToBoost": "c(s=>s.includes(t)&&s.length===e.MAX_SLOTS?[...s.filter(e=>e!==t),t]:s)"
  },
